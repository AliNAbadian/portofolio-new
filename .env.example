# Chat (server / standalone Docker only — never expose these to the client)
AVALAI_API_KEY=
# Optional override; default is https://api.avalai.ir/v1
AVALAI_BASE_URL=
CHAT_MODEL=gpt-4.1-nano-2025-04-14
# Extra CORS origins, comma-separated (localhost and GitHub Pages are already allowed)
CHAT_ALLOWED_ORIGINS=

# Client — full URL to the hosted chat API (required on GitHub Pages static export)
# Example: https://your-api-host.example/api/chat
NEXT_PUBLIC_CHAT_API_URL=
